{
  "expo": {
    "name": "Mano",
    "slug": "mano",
    "version": "1.0.0",
    "scheme": "mano",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.arahnofob.mano",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.arahnofob.mano",
      "adaptiveIcon": {
        "backgroundColor": "#0B4A44",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Mano records sound with the videos you film of signs."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Mano uses your photo library so you can add sign videos to your cards.",
          "cameraPermission": "Mano uses the camera so you can film signs for your cards.",
          "microphonePermission": "Mano records sound with the videos you film of signs."
        }
      ]
    ]
  }
}
